node_modules/
build/
dist/
coverage/
.DS_Store
*.log
# Plain .env may hold real secrets (e.g. GEMINI_API_KEY) — never commit it.
# Per-machine overrides (.env*.local) stay local too. The named Firebase env files
# (.env.production / .env.development / .env.example) ARE committed: the Firebase
# web config is not a secret (it ships to every browser).
.env
.env*.local

# ── Playwright (real-browser measurement; local only, never CI yet) ──
# ⚠️ THESE GO IN BEFORE THE TOOL IS INSTALLED, not after. `storageState` is a LOGGED-IN SESSION
# for the dev test account — a credential in every meaningful sense — and a run writes it the
# first time it authenticates. An ignore added afterwards does not un-stage what a `git add -A`
# already caught, and this repo has had `git add -A` reach for things twice.
tests/e2e/.auth/
test-results/
playwright-report/
blob-report/
.firebase/
.claude/
COMMUNITY_AGENTS_RECON.md
DISCOVER_PHASE1_REPORT.md
AGENT_FIELD_SURFACES_RECON.md
DIARY_CAROUSEL_REPORT.md
LOCATION_BUILD_REPORT.md
MOBILE_RECON.md
RECON_PACKAGES_REDESIGN.md

# ⚠️ RAW `firebase --debug` TRANSCRIPTS ARE NEVER COMMITTED (20 Aug 2026).
# Two of them reached a PUBLIC repo under run-artifacts/ before this rule existed. They carry the
# signed-in user's email address and the OAuth scope list the CLI requested — neither is secret in
# the credential sense (no token material was present, swept and confirmed), but neither is meant
# to be published either, and a debug log is not evidence anybody reads.
# The run-artifacts/ directory itself stays TRACKED on purpose — it is where measurement output
# lives. Only the deploy transcripts are excluded, by name.
run-artifacts/**/*-deploy.txt
run-artifacts/*-deploy.txt
