 ],
 "text": {
  "about": "Text that is not a heading, and not inside a button, a mark or a control, is sorted for Phase 3 by what it is, not counted as unclassified: numeral (a number, money or percentage alone), label (a <label>, or uppercase / letter-spaced text), caption (figcaption, small, or under 13px), body (a <p>, or the page's body ink), secondary (lighter than the page's body ink)."
 }
}