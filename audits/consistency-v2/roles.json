{
 "about": "Consistency audit v2 — the explicit role map. collect2.js gives every candidate element (anything clickable, any edged or filled box, any small mark, any form control, any row, any heading) the FIRST role whose test it passes, reading the roles in this order. A candidate no role claims is recorded as unclassified, with its selector and page, and is never forced into a group. Tests are class selectors from shell/primitives.css and the known components (`sel`), or one of the named structural tests below (`test`), never a guess from colour. `within` limits a role to elements inside a context the collector finds (navyHeader, pageHeader, dialog, footer, queryCard). A variant (filled / outline / text, selected / rest) is MEASURED inside a role, never used to choose it.",
 "tests": {
  "iconOnly": "a clickable element with no text of its own and an svg or img inside",
  "inDialog": "inside [role=dialog], [aria-modal=true] or dialog[open]",
  "dialogRoot": "the [role=dialog] / [aria-modal=true] / dialog[open] element itself",
  "dialogClose": "a button inside a dialog whose aria-label or text is close / dismiss / ×",
  "dialogFooter": "the last visible child of a dialog that holds a button, and is at the dialog's bottom edge",
  "dialogHeader": "the first visible child of a dialog, when it holds the dialog's title",
  "headingTag": "h1–h6, sorted by tag and context (see headings below)",
  "statusDot": "StatusDot's own markup: a square span (6–28px) holding one unclassed svg with viewBox 0 0 24 24 and stroke currentColor (lucide icons share the viewBox but carry class lucide)",
  "selectedState": "aria-selected / aria-pressed / aria-checked = true, or the class on / is-on / is-sel / sel / cb15-on"
 },
