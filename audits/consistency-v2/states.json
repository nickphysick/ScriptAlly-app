    { "path": "/queries/responses", "key": "queries-responses-empty", "family": "workspace", "state": "empty", "storage": { "scriptally_active_manuscript_id": "db60-pre" } },
    { "path": "/queries/packages", "key": "queries-packages-empty", "family": "workspace", "state": "empty", "storage": { "scriptally_active_manuscript_id": "db60-pre" } },
    { "path": "/manuscripts", "key": "manuscripts-empty", "family": "workspace", "state": "empty", "storage": { "scriptally_active_manuscript_id": "db60-pre" } },
    { "path": "/manuscripts/comps", "key": "manuscripts-comps-empty", "family": "workspace", "state": "empty", "storage": { "scriptally_active_manuscript_id": "db60-pre" } },
    { "path": "/manuscripts/versions", "key": "manuscripts-versions-empty", "family": "workspace", "state": "empty", "storage": { "scriptally_active_manuscript_id": "db60-pre" } },
