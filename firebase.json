{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "eval"
    ],
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "firestore": {
    "database": "ai-studio-ae82196c-c59e-40b9-b209-9fb02f67ade6",
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    }
  },
  "hosting": {
    "site": "scriptally-app",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/(?:[^/.aipsw][^/.]*|a(?:(?:[^/.ps][^/.]*|p(?:(?:[^/.i][^/.]*|i[^/.]+))?|s(?:(?:[^/.s][^/.]*|s(?:(?:[^/.e][^/.]*|e(?:(?:[^/.t][^/.]*|t(?:(?:[^/.s][^/.]*|s[^/.]+))?))?))?))?))?|i(?:(?:[^/.m][^/.]*|m(?:(?:[^/.a][^/.]*|a(?:(?:[^/.g][^/.]*|g(?:(?:[^/.e][^/.]*|e(?:(?:[^/.s][^/.]*|s[^/.]+))?))?))?))?))?|p(?:(?:[^/.r][^/.]*|r(?:(?:[^/.i][^/.]*|i(?:(?:[^/.v][^/.]*|v(?:(?:[^/.a][^/.]*|a(?:(?:[^/.c][^/.]*|c(?:(?:[^/.y][^/.]*|y[^/.]+))?))?))?))?))?))?|s(?:(?:[^/.t][^/.]*|t(?:(?:[^/.a][^/.]*|a(?:(?:[^/.t][^/.]*|t(?:(?:[^/.u][^/.]*|u(?:(?:[^/.s][^/.]*|s(?:(?:[^/.\\-][^/.]*|\\-(?:(?:[^/.d][^/.]*|d(?:(?:[^/.o][^/.]*|o(?:(?:[^/.t][^/.]*|t(?:(?:[^/.s][^/.]*|s[^/.]+))?))?))?))?))?))?))?))?))?))?|w(?:(?:[^/.e][^/.]*|e(?:(?:[^/.l][^/.]*|l(?:(?:[^/.c][^/.]*|c(?:(?:[^/.o][^/.]*|o(?:(?:[^/.m][^/.]*|m(?:(?:[^/.e][^/.]*|e[^/.]+))?))?))?))?))?))?)(?:/.*)?$",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/waitlist",
        "function": {
          "functionId": "waitlist",
          "region": "europe-west2"
        }
      },
      {
        "source": "/api/waitlist/**",
        "function": {
          "functionId": "waitlist",
          "region": "europe-west2"
        }
      },
      {
        "regex": "^/(?:[^a].*|a(?:[^s].*|s(?:[^s].*|s(?:[^e].*|e(?:[^t].*|t(?:[^s].*|s(?:[^/].*)?)?)?)?)?)?)?$",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
