rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health-check / connection test document match
    match /test/connection {
      allow read: if true;
    }

    // ----------------------------------------------------
    // GLOBAL REUSABLE HELPER FUNCTIONS
    // ----------------------------------------------------

    // ID validation ensuring alphanumeric IDs
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // Checking if the incoming payload exists and is valid
    function incoming() {
      return request.resource.data;
    }

    // Checking if existing document data exists
    function existing() {
      return resource.data;
    }

    // Authentication guard ensuring signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Validates that the active user matches the referenced owner ID path
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The single admin account permitted to create/delete shared communityAgents docs (FINDING-1).
    // MUST stay in sync with ADMIN_UID in src/lib/seedCommunityAgents.ts. The UID is NOT secret —
    // security is enforced by this rule, not by hiding the value.
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'r8kbaKbmguNfaoJTb9wH4BetJab2';
    }

    // ----------------------------------------------------
    // COMPONENT VALIDATORS (TYPE & SIZE CHECKS)
    // ----------------------------------------------------

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 256
        && data.email is string && data.email.size() <= 256
        && data.plan is string && (data.plan == 'Free' || data.plan == 'Pro')
        && data.trialStartDate is string && data.trialStartDate.size() <= 64
        // tasks-pages P5: the user's tag definitions — a list when present (safe hasAny pattern)
        && (!data.keys().hasAny(['tags']) || (data.tags is list && data.tags.size() <= 64))
        // board-optimise P5: the four desk behaviours as one map (the safe hasAny pattern)
        && (!data.keys().hasAny(['todoPrefs']) || data.todoPrefs is map)
        && data.subscriptionStatus is string && (
          data.subscriptionStatus == 'active' ||
          data.subscriptionStatus == 'trialing' ||
          data.subscriptionStatus == 'canceled' ||
          data.subscriptionStatus == 'none'
        )
        && (!data.keys().hasAny(['onboardingComplete']) || data.onboardingComplete is bool)
        && (!data.keys().hasAny(['queryingStage']) || (data.queryingStage is string && data.queryingStage.size() <= 32))
        // (No `journeyStage` clause. The field was written in four places and read in none — a
        // stored, validated, allowlisted, write-only value. Deleted rather than left as a slot
        // waiting to be filled by a reader that never came.)
        // Home market — ISO 3166-1 alpha-2, optional. Absent-or-string; rejects a literal null
        // (data.homeCountry is string), so "not set" always means the key is omitted.
        && (!data.keys().hasAny(['homeCountry']) || (data.homeCountry is string && data.homeCountry.size() <= 64))
        // App theme — optional; "cappuccino" | "bold" | "editorial". Absent-or-one-of-three.
        && (!data.keys().hasAny(['queriesTheme']) || (data.queriesTheme is string && (data.queriesTheme == 'cappuccino' || data.queriesTheme == 'bold' || data.queriesTheme == 'editorial')))
        // Package Workshop tour-seen flag — optional bool; absent-or-bool (rejects null).
        && (!data.keys().hasAny(['hasSeenTour']) || data.hasSeenTour is bool)
        // Personal genres (taxonomy Tier 2) — optional list, capped at the client's MAX_PERSONAL_GENRES.
        // Shape (id/label maps) is validated client-side; rules just bound presence + count.
        && (!data.keys().hasAny(['personalGenres']) || (data.personalGenres is list && data.personalGenres.size() <= 10))
        // Muted housekeeping rules — optional list of rule keys, bounded.
        && (!data.keys().hasAny(['mutedTaskRules']) || (data.mutedTaskRules is list && data.mutedTaskRules.size() <= 64))
        // The To-do board tour's seen-stamp (ISO timestamp; the hasSeenTour pattern).
        && (!data.keys().hasAny(['tourSeenAt']) || (data.tourSeenAt is string && data.tourSeenAt.size() <= 64))
        // Querying goals (one-screen dashboard §6) — ONLY the target is stored; progress derives.
        // Absent-or-valid: an int target 1–999, a period from the closed set.
        && (!data.keys().hasAny(['goalTarget']) || (data.goalTarget is int && data.goalTarget >= 1 && data.goalTarget <= 999))
        && (!data.keys().hasAny(['goalPeriod']) || (data.goalPeriod is string && (data.goalPeriod == 'quarter' || data.goalPeriod == 'month' || data.goalPeriod == 'year')))
        // Querying goals — the APPEND-ONLY list of intents that supersedes the two fields above.
        // Each entry is {target: int 1-999 | null, cadence: 'week'|'fortnight'|'month' | null,
        // effectiveFrom: 'YYYY-MM-DD'}.
        //
        // ⚠️ PER-ITEM SHAPE IS CLIENT-ENFORCED, BECAUSE RULES CANNOT ITERATE A LIST. There is no
        // loop, no map and no all() in this language, so a list can only be bounded by type and
        // size — the same limit `comps`, `personalGenres` and `mutedTaskRules` all live under, and
        // it is stated here so nobody reads the missing per-entry validation as an oversight.
        // The shape is owned by lib/queryingGoals.ts, which is the single writer.
        //
        // ⚠️ THE CAP IS ARTEFACT-LOCKED TO `MAX_GOAL_ENTRIES` in src/lib/queryingGoals.ts. If the
        // two drift, the client permits a write this rule denies SILENTLY.
        && (!data.keys().hasAny(['queryingGoals']) || (data.queryingGoals is list && data.queryingGoals.size() <= 200))
        // One-screen dashboard tour (§12): completion stamp + dismissal (the hasSeenTour pattern).
        && (!data.keys().hasAny(['tourCompletedAt']) || (data.tourCompletedAt is string && data.tourCompletedAt.size() <= 64))
        && (!data.keys().hasAny(['tourDismissed']) || data.tourDismissed is bool);
    }

    function isValidManuscript(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 512
        && data.genre is string && data.genre.size() <= 256
        && data.ageCategory is string && data.ageCategory.size() <= 128
        && data.wordCount is int && data.wordCount >= 0
        && data.logline is string && data.logline.size() <= 2048
        // ⚠️ OPTIONAL-WHEN-PRESENT, because both are cleared by OMITTING the key (`deleteField()`),
        // never by storing "". A required clause here would refuse every manuscript that has never
        // had one written — which is all of them until the writer types.
        //
        // ⚠️ `elevatorPitch` HAS EXISTED ON THE TYPE SINCE THE PITCH SHELF AND WAS NEVER ALLOWLISTED,
        // so every write of it has been denied in SILENCE (the affectedKeys gotcha) for as long as
        // the field has existed. The Overview's pitch card was held read-only for exactly that
        // reason, with a lock reading this file. It is editable now because this line exists.
        && (!data.keys().hasAny(['elevatorPitch']) || (data.elevatorPitch is string && data.elevatorPitch.size() <= 4096))
        // The writer's own working synopsis. NOT the packages synopsis MATERIALS — those are
        // `ManuscriptVersion` documents with componentType SYNOPSIS, reached through a package's
        // `synopsisVersionId`. No relationship between the two is asserted anywhere; whether this is
        // their master or a separate scratch copy is an open product question.
        && (!data.keys().hasAny(['synopsis']) || (data.synopsis is string && data.synopsis.size() <= 32768))
        // Structured comps — a list of maps {title, author?, publisher?, year?, note?, media?,
        // matchAxis?, inQuery?, source?}. Per-item shape is client-enforced (rules can't iterate a
        // list); optional-when-present so docs written before any field was added stay updatable.
        // The comps-page v2 fields (publisher/media/matchAxis/inQuery) and `verification` needed NO
        // rule change — the list is only size-capped, and `comps` is already in the update allowlist.
        // Capped at 100: a document-size and write-cost guard, NOT a commercial limit (free users get
        // unlimited comps; the Pro boundary is the Scout). ARTEFACT-LOCKED to MAX_COMPS in
        // src/lib/comps.ts — if the two drift, the client permits a write this rule denies SILENTLY.
        && (!data.keys().hasAll(['comps']) || (data.comps is list && data.comps.size() <= 100))
        // ── BOOK VERSIONS — named orderings of the book (manuscript-versions pack, D1/D4) ──────
        // ⚠️ NOT the `versions` SUBCOLLECTION, which holds MATERIALS. Different thing, same word;
        // the field is `bookVersions` for exactly that reason. See src/types.ts.
        //
        // ⚠️ THE SHAPE IS OWNED BY src/lib/bookVersions.ts, WHICH IS THE SINGLE WRITER — the same
        // division `queryingGoals` above already uses. This rule guards the list and its size; it
        // does not restate each entry's fields, because two definitions of one shape drift.
        //
        // ⚠️ THE CAP IS ARTEFACT-LOCKED TO `MAX_BOOK_VERSIONS`. If the constant moves and this does
        // not, the client permits an append this rule denies with no message.
        && (!data.keys().hasAny(['bookVersions']) || (data.bookVersions is list && data.bookVersions.size() <= 50))
        && data.status is string && (
          data.status == 'Drafting' ||
          data.status == 'Revising' ||
          data.status == 'Ready to Query' ||
          data.status == 'Querying' ||
          data.status == 'Shelved' ||
          data.status == 'On Submission'
        )
        && data.statusChangedDate is string && data.statusChangedDate.size() <= 64
        && (!data.keys().hasAll(['shelvedReason']) || (data.shelvedReason is string && data.shelvedReason.size() <= 2048))
        && (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 16384))
        && (!data.keys().hasAll(['subGenres']) || (data.subGenres is list && data.subGenres.size() <= 20))
        && (!data.keys().hasAll(['shelved']) || data.shelved is bool)
        && (!data.keys().hasAll(['activePackageId']) || (data.activePackageId is string && data.activePackageId.size() <= 128));
    }

    function isValidVersion(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.manuscriptId is string && data.manuscriptId.size() <= 128
        && data.userId == userId
        && data.componentType is string && (
          data.componentType == 'Query Letter' ||
          data.componentType == 'Synopsis' ||
          data.componentType == 'Sample Pages' ||
          data.componentType == 'Full Manuscript'
        )
        && data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 256
        && data.fileAttached is bool
        && data.createdDate is string && data.createdDate.size() <= 64
        && (!data.keys().hasAll(['fileName']) || (data.fileName is string && data.fileName.size() <= 512))
        && (!data.keys().hasAll(['contentDraft']) || (data.contentDraft is string && data.contentDraft.size() <= 262144))
        && (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 16384))
        // Which BOOK version a sample excerpts (D2). Optional — every material written before this
        // deploy has none and must stay valid. Sample-pages-only is a CLIENT rule (bookVersionOf in
        // src/lib/bookVersions.ts): a componentType changed after the fact would otherwise make an
        // existing, valid document unwritable, which is a worse failure than an ignored field.
        && (!data.keys().hasAny(['bookVersionId']) || (data.bookVersionId is string && data.bookVersionId.size() <= 128))
        // ⚠️ 'ref' IS THE NAME-ONLY MODE AND IS NOT 'link'. link was a URL to where the text lives;
        // ref records that the material exists elsewhere and names the file. Added rather than
        // repurposing link, which would relabel every stored URL as a filename.
        && (!data.keys().hasAll(['contentType']) || (data.contentType is string && (data.contentType == 'text' || data.contentType == 'link' || data.contentType == 'file' || data.contentType == 'ref')))
        && (!data.keys().hasAll(['contentLink']) || (data.contentLink is string && data.contentLink.size() <= 2048))
        // ⚠️ ABSENT-OR-ONE-OF-TWO. The archive model (broadsheet Ruling 2): a material is put away by
        // a single-document field update, which is a thing rules CAN express — unlike "refuse to
        // delete this if any package references it", which needs a collection scan and cannot be
        // written here at all. Absent means Active, so nothing is backfilled and every material
        // written before this field existed stays valid.
        && (!data.keys().hasAll(['status']) || (data.status is string && (data.status == 'Active' || data.status == 'Retired')))
        // ⚠️ ABSENT-OR-INT, NEVER NULL. `is int` is false for null, so "not counted" must mean the key
        // is omitted — the absent-means-absent idiom this file already uses for every optional field.
        // A ref or file material carries no wordCount at all rather than a 0, which would assert the
        // document is empty rather than unread. Bounded because a stored count is a claim about text
        // we hold, and contentDraft itself is capped at 256KB.
        && (!data.keys().hasAll(['wordCount']) || (data.wordCount is int && data.wordCount >= 0 && data.wordCount <= 10000000));
    }

    function isValidPackage(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.manuscriptId is string && data.manuscriptId.size() <= 128
        && data.userId == userId
        && data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 256
        // ⚠️ ALL THREE KEYS PRESENT, NONE OF THEM REQUIRED TO BE FILLED HERE. `""` is the unfilled
        // sentinel and omitting a key fails outright. "Only the covering letter is required" is
        // enforced on CREATE (see the create rule) and in the builder — NOT here, because this
        // validator also gates UPDATE, and a package written before that rule may hold `""` in the
        // letter slot. Requiring it on update would make every such record permanently unupdatable,
        // and therefore un-archivable and unrepairable — silently. Letter-only and
        // letter-plus-synopsis are real submission shapes; a letterless legacy record is a shape we
        // have to let the writer fix.
        && data.queryLetterVersionId is string && data.queryLetterVersionId.size() <= 128
        && data.synopsisVersionId is string && data.synopsisVersionId.size() <= 128
        && data.samplePagesVersionId is string && data.samplePagesVersionId.size() <= 128
        // ⚠️ THE VERSION SLOT IS OPTIONAL AND STAYS OPTIONAL (D3). Unlike the three above it is
        // absent rather than `""` when unset: those three are required-present by this validator
        // and cannot change that without invalidating every stored package, whereas this one is
        // new and can be modelled honestly from the start. A sent package can never gain one — the
        // freeze below covers it — so `Not recorded` is permanent for every package already out.
        && (!data.keys().hasAny(['bookVersionId'])
            || (data.bookVersionId is string && data.bookVersionId.size() >= 1
                && data.bookVersionId.size() <= 128))
        // ⚠️ THE LOCK STAMP (attachment model, D-D1). Optional; present means the package has gone out
        // and its slots are frozen — enforced on the update rule below, because a validator cannot
        // see what CHANGED. Stored rather than derived because rules can get() a document by path
        // but cannot QUERY for the queries that hold this package: the derived form is not
        // expressible in the one place enforcement has to happen.
        && (!data.keys().hasAny(['firstSentAt']) || (data.firstSentAt is string && data.firstSentAt.size() <= 64))
        // ⚠️ FREE TEXT, OPTIONAL, AND ABSENT WHEN EMPTY. `hasAny` rather than `is string` because an
        // unanswered question has no key at all; a stored `""` would claim the writer answered it.
        && (!data.keys().hasAny(['otherMaterials']) || (data.otherMaterials is string && data.otherMaterials.size() <= 512))
        && data.status is string && (data.status == 'Active' || data.status == 'Retired')
        && data.createdDate is string && data.createdDate.size() <= 64;
    }

    function isValidAgent(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        // At least one identity anchor — a NAME or an AGENCY (empty-and-valid). A named agency-less
        // agent (agency unknown for now) and an agency-only agent are both valid; only a record with
        // NEITHER is unidentifiable. Mirrors the client's name-or-agency skip in commitSmartImport /
        // validateSmartImport, so the commit can no longer silently re-drop a review-ready record.
        && data.name is string && data.name.size() <= 256
        && data.agency is string && data.agency.size() <= 256
        && (data.name.size() >= 1 || data.agency.size() >= 1)
        && data.email is string && data.email.size() <= 256
        && data.website is string && data.website.size() <= 512
        && data.genres is list && data.genres.size() <= 50
        && data.mswlNotes is string && data.mswlNotes.size() <= 4096
        && (!data.keys().hasAny(['starRating']) || (data.starRating is int && data.starRating >= 1 && data.starRating <= 5))
        && data.submissionStatus is string && (
          data.submissionStatus == 'Open' ||
          data.submissionStatus == 'Closed' ||
          data.submissionStatus == 'Unknown'
        )
        // responseTimeWeeks may be ABSENT ("Not set" — the Edit Agent panel deleteField()s it so the
        // deadline falls back to live-compute) OR a non-negative int. Mirrors the optional-field idiom
        // below (twitter/socials/...). NOTE: isValidCommunityAgent keeps the strict int form.
        && (!data.keys().hasAll(['responseTimeWeeks']) || (data.responseTimeWeeks is int && data.responseTimeWeeks >= 0))
        && (!data.keys().hasAny(['noResponseMeansNo']) || data.noResponseMeansNo is bool)
        && data.submissionMethod is string && data.submissionMethod.size() <= 128
        && (data.materialsWanted is list || data.materialsWanted is map) && data.materialsWanted.size() <= 20
        && data.dateAdded is string && data.dateAdded.size() <= 64
        && data.lastCheckedDate is string && data.lastCheckedDate.size() <= 64
        && data.notes is string && data.notes.size() <= 16384
        && (!data.keys().hasAll(['twitter']) || (data.twitter is string && data.twitter.size() <= 128))
        && (!data.keys().hasAll(['bluesky']) || (data.bluesky is string && data.bluesky.size() <= 128))
        && (!data.keys().hasAll(['instagram']) || (data.instagram is string && data.instagram.size() <= 128))
        && (!data.keys().hasAll(['country']) || (data.country is string && isKnownCountry(data.country)))
        && (!data.keys().hasAll(['city']) || (data.city is string && data.city.size() <= 128))
        && (!data.keys().hasAll(['agentNotes']) || (data.agentNotes is string && data.agentNotes.size() <= 4096))
        && (!data.keys().hasAll(['requeryPreference']) || (data.requeryPreference is string && (data.requeryPreference == 'yes' || data.requeryPreference == 'maybe' || data.requeryPreference == 'no')))
        && (!data.keys().hasAll(['socials']) || (data.socials is list && data.socials.size() <= 30))
        && (!data.keys().hasAll(['importedNeedsReview']) || data.importedNeedsReview is bool)
        && (!data.keys().hasAll(['setAside']) || data.setAside is bool)
        // Assisted-fill provenance — a small map keyed by agent field name ({source, foundAt} per
        // entry). Written only when a found value is saved unedited (To-do housekeeping batch).
        && (!data.keys().hasAll(['fieldSources']) || (data.fieldSources is map && data.fieldSources.size() <= 12));
    }

    // Country allowlist for agent/communityAgent `country` fields. Three tolerated shapes:
    //   • '' — cleared by the Edit Agent drawer's select (read paths treat '' as unknown);
    //   • a canonical ISO 3166-1 alpha-2 code — what every form writes since the ISO migration
    //     (MUST stay in sync with ISO_CODES in src/lib/territory.ts — asserted by
    //     src/lib/agentCountryRule.test.ts, the repo's rules-artefact pattern);
    //   • a LEGACY full name from the retired agentOptions.COUNTRIES picker — still present on
    //     pre-migration documents, and isValidAgent validates the whole merged doc on every
    //     update, so rejecting these would wedge edits to any agent that stored one. Read paths
    //     reverse-map them (territory.ts); new writes never produce them.
    function isKnownCountry(c) {
      return c == ''
        || c in [
          'AD', 'AE', 'AF', 'AG', 'AI', 'AL', 'AM', 'AO', 'AQ', 'AR', 'AS', 'AT', 'AU', 'AW', 'AX', 'AZ',
          'BA', 'BB', 'BD', 'BE', 'BF', 'BG', 'BH', 'BI', 'BJ', 'BL', 'BM', 'BN', 'BO', 'BQ', 'BR', 'BS',
          'BT', 'BV', 'BW', 'BY', 'BZ', 'CA', 'CC', 'CD', 'CF', 'CG', 'CH', 'CI', 'CK', 'CL', 'CM', 'CN',
          'CO', 'CR', 'CU', 'CV', 'CW', 'CX', 'CY', 'CZ', 'DE', 'DJ', 'DK', 'DM', 'DO', 'DZ', 'EC', 'EE',
          'EG', 'EH', 'ER', 'ES', 'ET', 'FI', 'FJ', 'FK', 'FM', 'FO', 'FR', 'GA', 'GB', 'GD', 'GE', 'GF',
          'GG', 'GH', 'GI', 'GL', 'GM', 'GN', 'GP', 'GQ', 'GR', 'GS', 'GT', 'GU', 'GW', 'GY', 'HK', 'HM',
          'HN', 'HR', 'HT', 'HU', 'ID', 'IE', 'IL', 'IM', 'IN', 'IO', 'IQ', 'IR', 'IS', 'IT', 'JE', 'JM',
          'JO', 'JP', 'KE', 'KG', 'KH', 'KI', 'KM', 'KN', 'KP', 'KR', 'KW', 'KY', 'KZ', 'LA', 'LB', 'LC',
          'LI', 'LK', 'LR', 'LS', 'LT', 'LU', 'LV', 'LY', 'MA', 'MC', 'MD', 'ME', 'MF', 'MG', 'MH', 'MK',
          'ML', 'MM', 'MN', 'MO', 'MP', 'MQ', 'MR', 'MS', 'MT', 'MU', 'MV', 'MW', 'MX', 'MY', 'MZ', 'NA',
          'NC', 'NE', 'NF', 'NG', 'NI', 'NL', 'NO', 'NP', 'NR', 'NU', 'NZ', 'OM', 'PA', 'PE', 'PF', 'PG',
          'PH', 'PK', 'PL', 'PM', 'PN', 'PR', 'PS', 'PT', 'PW', 'PY', 'QA', 'RE', 'RO', 'RS', 'RU', 'RW',
          'SA', 'SB', 'SC', 'SD', 'SE', 'SG', 'SH', 'SI', 'SJ', 'SK', 'SL', 'SM', 'SN', 'SO', 'SR', 'SS',
          'ST', 'SV', 'SX', 'SY', 'SZ', 'TC', 'TD', 'TF', 'TG', 'TH', 'TJ', 'TK', 'TL', 'TM', 'TN', 'TO',
          'TR', 'TT', 'TV', 'TW', 'TZ', 'UA', 'UG', 'UM', 'US', 'UY', 'UZ', 'VA', 'VC', 'VE', 'VG', 'VI',
          'VN', 'VU', 'WF', 'WS', 'YE', 'YT', 'ZA', 'ZM', 'ZW'
        ]
        || c in [
          'United Kingdom', 'Ireland', 'United States', 'Canada', 'Australia', 'New Zealand',
          'France', 'Germany', 'India', 'Italy', 'Netherlands', 'Spain', 'Sweden', 'Other'
        ];
    }

    function isValidCommunityAgent(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 256
        && data.agency is string && data.agency.size() <= 256
        && data.email is string && data.email.size() <= 256
        && data.website is string && data.website.size() <= 512
        && data.genres is list && data.genres.size() <= 50
        && data.mswlNotes is string && data.mswlNotes.size() <= 4096
        && data.starRating is int && data.starRating >= 1 && data.starRating <= 5
        && data.submissionStatus is string && (
          data.submissionStatus == 'Open' ||
          data.submissionStatus == 'Closed' ||
          data.submissionStatus == 'Unknown'
        )
        && data.responseTimeWeeks is int && data.responseTimeWeeks >= 0
        && data.noResponseMeansNo is bool
        && data.submissionMethod is string && data.submissionMethod.size() <= 128
        && (data.materialsWanted is list || data.materialsWanted is map) && data.materialsWanted.size() <= 20
        && data.dateAdded is string && data.dateAdded.size() <= 64
        && data.lastCheckedDate is string && data.lastCheckedDate.size() <= 64
        && data.notes is string && data.notes.size() <= 16384
        && data.contributedByCount is int && data.contributedByCount >= 0
        && data.lastVerifiedDate is string && data.lastVerifiedDate.size() <= 64
        && data.dataSource is string && (data.dataSource == 'seed' || data.dataSource == 'community')
        && data.communityQueryCount is int && data.communityQueryCount >= 0
        && (!data.keys().hasAll(['twitter']) || (data.twitter is string && data.twitter.size() <= 128))
        && (!data.keys().hasAll(['bluesky']) || (data.bluesky is string && data.bluesky.size() <= 128))
        && (!data.keys().hasAll(['instagram']) || (data.instagram is string && data.instagram.size() <= 128))
        && (!data.keys().hasAll(['country']) || (data.country is string && isKnownCountry(data.country)))
        && (!data.keys().hasAll(['city']) || (data.city is string && data.city.size() <= 128))
        && (!data.keys().hasAll(['agentNotes']) || (data.agentNotes is string && data.agentNotes.size() <= 4096));
    }

    function isValidQuery(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.manuscriptId is string && data.manuscriptId.size() <= 128
        && data.agentId is string && data.agentId.size() <= 128
        && data.packageId is string && data.packageId.size() <= 128
        && data.status is string && (
          data.status == 'Queried' ||
          data.status == 'Partial Requested' ||
          data.status == 'Partial Sent' ||
          data.status == 'Full Requested' ||
          data.status == 'Full Sent' ||
          data.status == 'Revise & Resubmit' ||
          data.status == 'Offer' ||
          data.status == 'Rejected' ||
          data.status == 'Withdrawn' ||
          data.status == 'No Response'
        )
        && (data.get('dateSent', null) == null || (data.dateSent is string && data.dateSent.size() <= 64))
        && (data.get('personalisationNotes', null) == null || (data.personalisationNotes is string && data.personalisationNotes.size() <= 16384))
        && data.sendMethod is string && (
          data.sendMethod == 'Email' ||
          data.sendMethod == 'Online Form' ||
          data.sendMethod == 'Query Manager' ||
          data.sendMethod == 'Post'
        )
        && (data.get('nudgeDate', null) == null || (data.nudgeDate is string && data.nudgeDate.size() <= 64))
        && (data.get('lastNudgeSentDate', null) == null || (data.lastNudgeSentDate is string && data.lastNudgeSentDate.size() <= 64))
        && (data.get('responseDeadline', null) == null || (data.responseDeadline is string && data.responseDeadline.size() <= 64))
        && (data.get('partialRequestedDate', null) == null || (data.partialRequestedDate is string && data.partialRequestedDate.size() <= 64))
        && (data.get('partialSentDate', null) == null || (data.partialSentDate is string && data.partialSentDate.size() <= 64))
        && (data.get('fullRequestedDate', null) == null || (data.fullRequestedDate is string && data.fullRequestedDate.size() <= 64))
        && (data.get('fullSentDate', null) == null || (data.fullSentDate is string && data.fullSentDate.size() <= 64))
        && (data.get('lastStatusChange', null) == null || (data.lastStatusChange is timestamp || data.lastStatusChange is string))
        && (data.get('responseReceivedAt', null) == null || (data.responseReceivedAt is timestamp || data.responseReceivedAt is string))
        && (data.get('materialsRequestedType', null) == null || (data.materialsRequestedType is string && data.materialsRequestedType.size() <= 256))
        && (data.get('materialsRequestedQuantity', null) == null || (data.materialsRequestedQuantity is string || data.materialsRequestedQuantity is int || data.materialsRequestedQuantity is float || data.materialsRequestedQuantity is number))
        && (data.get('expectedSendDate', null) == null || (data.expectedSendDate is timestamp || data.expectedSendDate is string))
        && (data.get('sendReminderDate', null) == null || (data.sendReminderDate is timestamp || data.sendReminderDate is string))
        && (data.get('rrNotes', null) == null || (data.rrNotes is string && data.rrNotes.size() <= 16384))
        && (data.get('rejectionFeedbackType', null) == null || (data.rejectionFeedbackType is string && data.rejectionFeedbackType.size() <= 256))
        && (data.get('rejectionFeedbackText', null) == null || (data.rejectionFeedbackText is string && data.rejectionFeedbackText.size() <= 16384))
        && (data.get('rejectionReflection', null) == null || (data.rejectionReflection is string && data.rejectionReflection.size() <= 16384))
        && (data.get('rejectionLesson', null) == null || (data.rejectionLesson is string && data.rejectionLesson.size() <= 16384))
        && (data.get('rejectedFromStatus', null) == null || (data.rejectedFromStatus is string && data.rejectedFromStatus.size() <= 64))
        && (data.get('rejectedDate', null) == null || (data.rejectedDate is string && data.rejectedDate.size() <= 64))
        // ⚠️ THE ONE STORED THING IN §5, and it is stored because a DECISION is not derivable: the
        // writer chose to keep tracking a query the facts would otherwise offer to close. Everything
        // else in that section — the nudge count, the dates, whether a nudge went unanswered, how
        // long since the window closed — is read off the activity log.
        && (data.get('closureOfferDismissed', null) == null || data.closureOfferDismissed is bool)
        // ⚠️ THE WRITER'S OWN EXPECTED DATE, AND IT IS STORED BECAUSE PROVENANCE CANNOT BE DERIVED.
        // The AGENCY's window is derived at read time from their current stated weeks, so it moves
        // and disappears with them; a date the WRITER set is a fact about the writer that nothing
        // else can produce. Two fields for two facts, rather than one date and a flag beside it —
        // a flag can drift from the value it describes, and any write path that sets one without
        // the other produces a date attributed to the wrong person with nothing failing.
        //
        // ⚠️ NOTHING BUT THE WRITER'S CONTROL MAY WRITE HERE. That is what makes provenance
        // structural: a value in this field is the writer's because there is nowhere else it can
        // have come from.
        && (data.get('writerExpectedDate', null) == null || (data.writerExpectedDate is string && data.writerExpectedDate.size() <= 64))
        // §1 — WHEN the writer set that date. A moment of recording, never the date expected; the
        // two being confused is why it is named SetAt. Optional: every row written before this
        // deploy has none, and absence is a meaningful state (older than any reply-stated window).
        && (data.get('writerExpectedSetAt', null) == null || (data.writerExpectedSetAt is string && data.writerExpectedSetAt.size() <= 64))
        && (data.get('offerDate', null) == null || (data.offerDate is timestamp || data.offerDate is string))
        && (data.get('offerResponseDeadline', null) == null || (data.offerResponseDeadline is timestamp || data.offerResponseDeadline is string))
        && (data.get('offerNotes', null) == null || (data.offerNotes is string && data.offerNotes.size() <= 16384))
        && (data.get('closingReason', null) == null || (data.closingReason is string && data.closingReason.size() <= 256))
        && (data.get('closingNotes', null) == null || (data.closingNotes is string && data.closingNotes.size() <= 16384))
        && (data.get('materialsWanted', null) == null || ((data.materialsWanted is list || data.materialsWanted is map) && data.materialsWanted.size() <= 20))
        && (data.get('ifNoResponse', null) == null || (data.ifNoResponse is string && data.ifNoResponse.size() <= 256))
        && (data.get('rejectionType', null) == null || (data.rejectionType is string && data.rejectionType.size() <= 256))
        && (data.get('agentComments', null) == null || (data.agentComments is string && data.agentComments.size() <= 16384))
        && (data.get('fullVersionSent', null) == null || (data.fullVersionSent is string && data.fullVersionSent.size() <= 512))
        && (data.get('revisionRound', null) == null || (data.revisionRound is int && data.revisionRound >= 1 && data.revisionRound <= 100))
        && (data.get('hasAgentResponded', null) == null || data.hasAgentResponded is bool);
    }

    /**
     * ⚠️ THE AUTHORITATIVE STORE — AND UNTIL 26 Aug 2026 IT WAS THE LOOSELY-VALIDATED ONE.
     * `recomputeQuery` derives status and every pipeline date from THIS collection
     * (`subcollectionDocToDerivable`, src/lib/recomputeQuery.ts:31), while the DISPLAY projection
     * beside it — /users/{uid}/activities, `isValidActivity` below — already enforced the full
     * ten-value enum. The store that DECIDES status restricted no keys and never looked at
     * `resultingStatus` at all. The asymmetry was exactly backwards.
     *
     * The `queries` block's "the door this leaves open is closed at the source instead" reasoning
     * covers the query document's own `status` field. It never covered the subcollection that
     * DERIVES it, and nothing else did either.
     *
     * ⚠️ THE ALLOWLIST IS DERIVED FROM THE WRITE PATHS, NOT FROM A SPEC — and it is a SUPERSET of
     * every shape any writer has ever produced, because the move (db.tsx:3084) and the
     * correction-restore (:2985) write back whatever they READ, and `saveQueryEdits` patches with
     * `batch.update`, where `incoming()` is the MERGED document. An allowlist narrower than real
     * data denies those paths silently, on legacy rows, with a permission error the UI shows as
     * nothing happening.
     *   type/resultingStatus/createdAt/note/queryId/agentName/manuscriptTitle
     *                     db.tsx logDoc (:2152) + updateQueryStatus (:2340) + recordMaterialsSent
     *                     (:2463) + saveQueryEdits.ts (:126) + smartImportCommit.ts (:216)
     *   dateProvisional   smartImportCommit.ts:222 (true) · saveQueryEdits.ts:161 (false)
     *   reminderDate      logNudge.ts:133
     *   replyWeeks        holdingReply.ts:126
     *
     * ⚠️ `type` DOES NOT TAKE THE ENUM CHECK, AND MUST NOT. Four non-enum values are load-bearing —
     * 'Nudge sent' (logNudge.ts:86), 'Holding reply' (holdingReply.ts:43), 'Offer accepted' and
     * 'Offer declined' (offerDecision.ts:28-29) — and QueryTimeline.tsx:280,304 FILTERS on them to
     * render the nudge and holding-reply rows. Constraining `type` here would deny every nudge,
     * holding reply and offer decision AND blank those rows. The enum belongs on `resultingStatus`,
     * which those shapes correctly omit: they are not status-bearing, which is the whole point of
     * them (recomputeQuery ignores a rung with no recognised status).
     *
     * Locked in tests/rules/firestore.rules.test.ts — five REJECT cases and four ALLOW cases,
     * including a legacy migration-heal row proved both creatable and EDITABLE.
     */
    function isValidActivityNested(data) {
      return data.keys().hasOnly([
          'type', 'resultingStatus', 'createdAt', 'note',
          'queryId', 'agentName', 'manuscriptTitle',
          'dateProvisional', 'reminderDate', 'replyWeeks'
        ])
        && data.type is string && data.type.size() <= 128
        && (data.createdAt is timestamp || data.createdAt is string)
        && data.note is string && data.note.size() <= 16384
        && (!data.keys().hasAny(['resultingStatus']) || (data.resultingStatus is string && (
          data.resultingStatus == 'Queried' ||
          data.resultingStatus == 'Partial Requested' ||
          data.resultingStatus == 'Partial Sent' ||
          data.resultingStatus == 'Full Requested' ||
          data.resultingStatus == 'Full Sent' ||
          data.resultingStatus == 'Revise & Resubmit' ||
          data.resultingStatus == 'Offer' ||
          data.resultingStatus == 'Rejected' ||
          data.resultingStatus == 'Withdrawn' ||
          data.resultingStatus == 'No Response'
        )))
        && (!data.keys().hasAny(['queryId']) || (data.queryId is string && data.queryId.size() <= 128))
        && (!data.keys().hasAny(['agentName']) || (data.agentName is string && data.agentName.size() <= 256))
        && (!data.keys().hasAny(['manuscriptTitle']) || (data.manuscriptTitle is string && data.manuscriptTitle.size() <= 512))
        && (!data.keys().hasAny(['dateProvisional']) || data.dateProvisional is bool)
        && (!data.keys().hasAny(['reminderDate']) || (data.reminderDate is string && data.reminderDate.size() <= 64))
        && (!data.keys().hasAny(['replyWeeks']) || (data.replyWeeks is number && data.replyWeeks >= 0 && data.replyWeeks <= 520));
    }

    // (isValidTopLevelActivity is gone with the RETIRED users/{uid}/activity store — Tier 3 ·
    // Phase 7. Zero writers since the derived-status era; its one reader fed unrendered state.)

    // (isValidManuscriptNote is gone with the RETIRED manuscripts/{id}/notes subcollection —
    // Tier 2 · Phase 6. The jottings feed lost its UI long ago; nothing wrote or read the store.)

    // Agent notes: { text, createdAt } — the shape written by handleAddAgentNote.
    function isValidAgentNote(data) {
      return data.text is string && data.text.size() >= 1 && data.text.size() <= 16384
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Top-level user-authored notes (desk notes / dated tasks). Distinct from the nested
    // manuscript/agent notes above. All dates are ISO strings: dueDate is date-only "YYYY-MM-DD"
    // (nullable), the stamps are full ISO datetimes (doneAt nullable). Every field is validated —
    // any field absent from this shape is silently dropped on write.
    function isValidUserNote(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'text', 'colour', 'dueDate', 'done', 'doneAt', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 16384
        && data.colour is string && (data.colour == 'pink' || data.colour == 'sage' || data.colour == 'yellow')
        && (data.dueDate == null || (data.dueDate is string && data.dueDate.size() <= 16))
        && data.done is bool
        && (data.doneAt == null || (data.doneAt is string && data.doneAt.size() <= 64))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    // Canonical stored user task. Record scope (queryId/agentId/manuscriptId) is optional user
    // input — string when present, rejecting a literal null.
    function isValidUserTask(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'text', 'detail', 'done', 'completedAt', 'createdAt', 'updatedAt', 'queryId', 'agentId', 'manuscriptId', 'dueDate', 'surfaceOffset', 'committedDate', 'tags', 'estimateMin', 'colour'])
        && data.id is string && data.id.size() <= 128
        && data.userId == userId
        // No min length — the To-do board's blank-note flow creates an empty task then fills it.
        && data.text is string && data.text.size() <= 16384
        // notes-and-tasks: the optional detail line beneath the title.
        && (!data.keys().hasAny(['detail']) || (data.detail is string && data.detail.size() <= 16384))
        // tasks-pages P5: applied tag IDS — a list when present (the safe hasAny pattern; never == null)
        && (!data.keys().hasAny(['tags']) || (data.tags is list && data.tags.size() <= 32))
        // board-optimise P7: a ladder value in minutes — a number when present (the safe hasAny)
        && (!data.keys().hasAny(['estimateMin']) || (data.estimateMin is int && data.estimateMin > 0 && data.estimateMin <= 600))
        // ⚠️ NOTEBOARD COLOUR — the note's paper, one of three. UNDEPLOYED as of 22 Aug 2026: it is
        // in this file and not yet in the live ruleset, so every colour write is denied until one
        // dev rules deploy lands. That is why the client NEVER carries it on a create — hasOnly()
        // denies the whole document for one unlisted key, so a create carrying it would lose the
        // note rather than the colour. `setUserTaskColour` sends it alone and returns whether it
        // landed; a note with none reads yellow. Same safe hasAny pattern as every optional above.
        && (!data.keys().hasAny(['colour']) || (data.colour is string && data.colour in ['pink', 'sage', 'yellow']))
        && data.done is bool
        // SAFE optional-field pattern (hasAny guard) — matches every other optional field here. The
        // old `data.completedAt == null` errored on an ABSENT key (Firestore rules do NOT return null
        // for a missing map field), which silently DENIED every create (the composer never writes
        // completedAt on create). Proven with the Rules :test API; see reports/todo-save-and-today.md.
        && (!data.keys().hasAny(['completedAt']) || (data.completedAt is string && data.completedAt.size() <= 64))
        && (!data.keys().hasAny(['queryId']) || (data.queryId is string && data.queryId.size() <= 128))
        && (!data.keys().hasAny(['agentId']) || (data.agentId is string && data.agentId.size() <= 128))
        && (!data.keys().hasAny(['manuscriptId']) || (data.manuscriptId is string && data.manuscriptId.size() <= 128))
        // Due day — ISO date-only "YYYY-MM-DD"; optional, string when present (rejects null).
        && (!data.keys().hasAny(['dueDate']) || (data.dueDate is string && data.dueDate.size() <= 16))
        // notes-and-tasks: the in-app surfacing lead — one of three fixed strings; optional.
        && (!data.keys().hasAny(['surfaceOffset']) || (data.surfaceOffset is string && data.surfaceOffset in ['on-day', 'day-before', 'week-before']))
        // Today's-list commitment — ISO date-only "YYYY-MM-DD"; optional, string when present.
        && (!data.keys().hasAny(['committedDate']) || (data.committedDate is string && data.committedDate.size() <= 16))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidActivity(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.queryId is string && data.queryId.size() <= 128
        && data.manuscriptId is string && data.manuscriptId.size() <= 128
        && data.activityType is string && (
          data.activityType == 'Status Changed' ||
          data.activityType == 'Nudge Sent' ||
          // Phase 1 — a reply that decides nothing (holding-reply pack). NON-STATUS by
          // construction: it carries no resultingStatus, so recomputeQuery cannot see it and no
          // derived field can move. Deploys WITH writerExpectedSetAt as one release.
          data.activityType == 'Holding Reply' ||
          data.activityType == 'Offer Accepted' ||
          data.activityType == 'Offer Declined' ||
          data.activityType == 'Query Sent' ||
          data.activityType == 'Materials Sent' ||
          data.activityType == 'Agent Added' ||
          data.activityType == 'Agent Updated' ||
          data.activityType == 'Agent Deleted' ||
          data.activityType == 'Manuscript Added' ||
          data.activityType == 'Manuscript Updated' ||
          data.activityType == 'Manuscript Deleted'
        )
        && data.description is string && data.description.size() <= 512
        && data.date is string && data.date.size() <= 64
        && data.details is string && data.details.size() <= 4096
        && (!data.keys().hasAny(['resultingStatus']) || (data.resultingStatus is string && (
          data.resultingStatus == 'Queried' ||
          data.resultingStatus == 'Partial Requested' ||
          data.resultingStatus == 'Partial Sent' ||
          data.resultingStatus == 'Full Requested' ||
          data.resultingStatus == 'Full Sent' ||
          data.resultingStatus == 'Revise & Resubmit' ||
          data.resultingStatus == 'Offer' ||
          data.resultingStatus == 'Rejected' ||
          data.resultingStatus == 'Withdrawn' ||
          data.resultingStatus == 'No Response'
        )))
        // ── the send's own materials (Query Centre §2) ──────────────────────────────────────
        // ⚠️ OPTIONAL, because every activity written before this deploy has none and must stay
        // valid — a required key here would reject every correction to an existing event.
        //
        // ⚠️ THE SAME SHAPE AND CAP AS THE QUERY'S OWN FIELD: a list of strings (legacy) or maps
        // (structured QueryMaterial), 20 at most. The two are deliberately identical so a
        // first-write migration can move a value across without it changing validity on the way.
        //
        // ⚠️ IT IS NAMED FOR THE EVENT IT SITS ON. On an activity, `materials` means what went with
        // THIS send — a query-level `materialsWanted` had to carry both "what the agent asks for"
        // and "what you sent", which is the ambiguity that stopped a sent-flag being added.
        && (data.get('materials', null) == null
            || ((data.materials is list || data.materials is map) && data.materials.size() <= 20))
        // ── which BOOK version this send carried (D3) ─────────────────────────────────────────
        // ⚠️ OPTIONAL, and payload only. `recomputeQuery` does not read it — a version annotates an
        // event, it never decides a status, which is why this feature needed no change there.
        //
        // ⚠️ SENDS ONLY IS A CLIENT RULE, not this one. Restating "Full Sent or Partial Sent" here
        // would make a CORRECTION that moves an event between statuses fail on a field it is not
        // touching; the client is the single writer and never puts one on another type.
        && (!data.keys().hasAny(['bookVersionId']) || (data.bookVersionId is string && data.bookVersionId.size() <= 128));
    }

    function isValidJournalEntry(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.queryId is string && data.queryId.size() <= 128
        && data.entryText is string && data.entryText.size() >= 1 && data.entryText.size() <= 16384
        && data.createdAt is string && data.createdAt.size() <= 64
        // §1c — pin state is per note, and a decision rather than a derivable fact.
        && (data.get('pinned', null) == null || data.pinned is bool);
    }

    function isValidDismissedTask(data, userId) {
      return data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.taskType is string && data.taskType.size() <= 128
        && data.relatedRecordId is string && data.relatedRecordId.size() <= 128
        && data.dismissedDate is string && data.dismissedDate.size() <= 64
        && data.dismissType is string && (
          data.dismissType == 'permanent' ||
          data.dismissType == 'fixed snooze' ||
          data.dismissType == 'custom date'
        )
        && (!data.keys().hasAll(['resurfaceDate']) || (data.resurfaceDate is string && data.resurfaceDate.size() <= 64))
        && (!data.keys().hasAll(['snoozeDays']) || (data.snoozeDays is int && data.snoozeDays >= 0 && data.snoozeDays <= 3650));
    }

    // TaskFlag — the user's stance on a derived task. Deterministic id; components stored as fields.
    // All optional dates are ISO strings; snoozeCount is a non-negative int.
    function isValidTaskFlag(data, userId) {
      return data.keys().hasOnly(['id', 'userId', 'taskType', 'queryId', 'agentId', 'rule', 'snoozedUntil', 'snoozeCount', 'committedDate', 'skippedAt', 'resolvedAt'])
        && data.id is string && data.id.size() <= 400
        && data.userId == userId
        && data.taskType is string && data.taskType.size() <= 128
        && data.snoozeCount is int && data.snoozeCount >= 0 && data.snoozeCount <= 100000
        && (!data.keys().hasAny(['queryId']) || (data.queryId is string && data.queryId.size() <= 128))
        && (!data.keys().hasAny(['agentId']) || (data.agentId is string && data.agentId.size() <= 128))
        && (!data.keys().hasAny(['rule']) || (data.rule is string && data.rule.size() <= 128))
        && (!data.keys().hasAny(['snoozedUntil']) || (data.snoozedUntil is string && data.snoozedUntil.size() <= 64))
        && (!data.keys().hasAny(['committedDate']) || (data.committedDate is string && data.committedDate.size() <= 16))
        && (!data.keys().hasAny(['skippedAt']) || (data.skippedAt is string && data.skippedAt.size() <= 64))
        && (!data.keys().hasAny(['resolvedAt']) || (data.resolvedAt is string && data.resolvedAt.size() <= 64));
    }

    // UserTask — a task the writer wrote (the only stored to-do object). Nullable owner: at most one
    // of queryId/agentId/manuscriptId. body/text may be empty; done is a bool; stamps are ISO strings.
    // ----------------------------------------------------
    // FIRESTORE ENDPOINTS INTEGRATIONS
    // ----------------------------------------------------

    // ROUTE: Users
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'plan', 'trialStartDate', 'subscriptionStatus', 'onboardingComplete', 'queryingStage', 'homeCountry', 'queriesTheme', 'hasSeenTour', 'personalGenres', 'mutedTaskRules', 'tourSeenAt', 'tags', 'goalTarget', 'goalPeriod', 'queryingGoals', 'tourCompletedAt', 'tourDismissed', 'todoPrefs', 'notifyPrefs', 'marketingConsent', 'workspacePrefs', 'scheduledDeletion'])
        /**
         * ⚠️ A CLIENT MAY NOT CHANGE ITS OWN `plan` — THIS LINE IS THE WHOLE GUARD.
         *
         * `plan` stays in the allowlist above and `isValidUser` still checks its VALUE is
         * 'Free' | 'Pro' — neither of those stops anything, because 'Pro' is a legal value. Any
         * client could simply write itself one, and two surfaces did exactly that: the public
         * /pricing page's "Activate Pro account now" button, and the CSV importer's `user` row
         * type, which mapped a spreadsheet column onto the field. Both are deleted.
         *
         * ⚠️ IT IS AN EQUALITY CLAUSE, NOT A REMOVAL FROM THE ALLOWLIST, AND THAT IS DELIBERATE.
         * The allowlist governs which KEYS an update may touch; this governs which VALUES may
         * move. Keeping the key listed means an ordinary whole-document write that carries an
         * UNCHANGED plan still succeeds — which matters, because updateUserProfile sends merged
         * documents — while any actual change is denied. Dropping the key instead would deny
         * those innocent writes too.
         *
         * A plan change is a billing event: it belongs to a server with a payment processor
         * behind it. Locked in tests/rules/firestore.rules.test.ts.
         */
        && incoming().plan == existing().plan
      );

      // ROUTE: Manuscripts
      match /manuscripts/{manuscriptId} {
        allow get, delete: if isOwner(userId) && isValidId(manuscriptId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(manuscriptId) && isValidManuscript(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(manuscriptId) && isValidManuscript(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'genre', 'subGenres', 'ageCategory', 'wordCount', 'logline', 'comps', 'status', 'shelvedReason', 'statusChangedDate', 'notes', 'shelved', 'activePackageId', 'bookVersions',
            // book profile amendment 2 — see the two clauses in isValidManuscript above.
            'elevatorPitch', 'synopsis'
          ])
        );

        // The manuscripts/{id}/notes subcollection is RETIRED (Tier 2 · Phase 6): no match block
        // = default-deny, all ops. Legacy note documents remain in Firestore, deliberately
        // unreadable and unwritable — left in place, not migrated (run report). The 'notes'
        // entry in the update allowlist above is the manuscript DOC's own flat field, unrelated.
      }

      // ROUTE: ManuscriptVersions
      match /versions/{versionId} {
        allow get, delete: if isOwner(userId) && isValidId(versionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(versionId) && isValidVersion(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(versionId) && isValidVersion(incoming(), userId) && (
          // ⚠️ `wordCount` MUST BE HERE OR EVERY EDIT THAT CHANGES PASTED TEXT IS DENIED — hasOnly fails
          // the WHOLE write on one unlisted changed key, silently. Exactly the F7 shape, one
          // collection along; added with the field rather than after someone reports a dead Save.
          // ⚠️ 'status' RIDES THE SAME COMMIT AS THE FIELD, for the reason F7 cost a day: a field can
          // be perfectly validated above and still be undeployable, because isValidVersion runs on
          // every write while hasOnly runs only on updates. Archiving IS an update and nothing else,
          // so leaving it out here would deny every archive silently while the validator said yes.
          incoming().diff(existing()).affectedKeys().hasOnly(['versionName', 'fileAttached', 'fileName', 'contentDraft', 'notes', 'contentType', 'contentLink', 'wordCount', 'status', 'bookVersionId'])
        );
      }

      // ROUTE: SubmissionPackages
      match /packages/{packageId} {
        allow get, delete: if isOwner(userId) && isValidId(packageId);
        allow list: if isOwner(userId);
        // ⚠️ THE LETTER IS REQUIRED ON CREATE AND ONLY ON CREATE. Nothing new may be written without
        // a covering letter; an existing record that predates the rule stays repairable. Putting it
        // inside isValidPackage would apply it to update too — see the note there.
        allow create: if isOwner(userId) && isValidId(packageId) && isValidPackage(incoming(), userId)
          && incoming().queryLetterVersionId.size() >= 1;
        // ⚠️ A SENT PACKAGE'S CONTENTS ARE IMMUTABLE, AND THIS IS THE GUARANTEE — not the client
        // check beside it. Once `firstSentAt` exists the three slot fields cannot change, so every
        // query that used this package keeps reporting what the agent actually received. The name,
        // the free-text line and `status` stay writable: renaming is filing, not misreporting, and
        // freezing `status` would make a sent package impossible to archive.
        //
        // ⚠️ AND THE STAMP IS WRITE-ONCE. Left mutable it would be the unlock: clear the field,
        // edit the slots, and the guarantee is a formality. `hasAny` on the CHANGED keys is what
        // says "you may add it, you may never touch it again".
        allow update: if isOwner(userId) && isValidId(packageId) && isValidPackage(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['packageName', 'queryLetterVersionId', 'synopsisVersionId', 'samplePagesVersionId', 'otherMaterials', 'status', 'firstSentAt', 'bookVersionId'])
          && (
            !existing().keys().hasAny(['firstSentAt'])
            // ⚠️ THE VERSION JOINS THE FROZEN SET, and it is the same argument as the other three:
            // a package that has gone out is a record of what the agent received, and the shape of
            // the book it carried is part of that record. Left mutable, a writer could retro-fit a
            // version onto a sent package and every scorecard reading it would silently re-attribute
            // requests that arrived on something else.
            || !incoming().diff(existing()).affectedKeys().hasAny(['queryLetterVersionId', 'synopsisVersionId', 'samplePagesVersionId', 'firstSentAt', 'bookVersionId'])
          );
      }

      // ROUTE: Agents
      match /agents/{agentId} {
        allow get, delete: if isOwner(userId) && isValidId(agentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(agentId) && isValidAgent(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(agentId) && isValidAgent(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'agency', 'email', 'website', 'country', 'city', 'twitter', 'bluesky', 'instagram', 'socials', 'genres', 'mswlNotes',
            'starRating', 'submissionStatus', 'responseTimeWeeks', 'noResponseMeansNo', 'submissionMethod',
            'materialsWanted', 'lastCheckedDate', 'notes', 'agentNotes', 'requeryPreference', 'importedNeedsReview', 'setAside', 'fieldSources'
          ])
        );

        match /notes/{noteId} {
          allow get, delete: if isOwner(userId) && isValidId(noteId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidId(noteId) && isValidAgentNote(incoming());
          allow update: if isOwner(userId) && isValidId(noteId) && isValidAgentNote(incoming()) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['text'])
          );
        }
      }

      // ROUTE: Queries
      match /queries/{queryId} {
        allow get, delete: if isOwner(userId) && isValidId(queryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(queryId) && isValidQuery(incoming(), userId);
        // 'status' stays in this update allowlist DELIBERATELY (Tier 3 · Phase 5): recomputeQuery
        // — the derivation engine, and status's only legitimate writer after addQuery's create
        // seed — writes via updateDoc, an UPDATE at this layer, and affectedKeys() carries
        // 'status' exactly when a transition happens, so removing it would deny every real
        // transition. The door this leaves open (a client update writing a non-derived status)
        // is closed at the source instead: queryStatusWriters.test.ts locks the known query
        // mutation paths to zero bare status write keys.
        allow update: if isOwner(userId) && isValidId(queryId) && isValidQuery(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'manuscriptId', 'dateSent',
            'status', 'personalisationNotes', 'sendMethod', 'nudgeDate', 'lastNudgeSentDate', 'responseDeadline',
            'partialRequestedDate', 'partialSentDate', 'fullRequestedDate', 'fullSentDate',
            'lastStatusChange', 'responseReceivedAt', 'materialsRequestedType', 'materialsRequestedQuantity',
            'expectedSendDate', 'sendReminderDate', 'rrNotes', 'rejectionFeedbackType', 'rejectionFeedbackText',
            'rejectionReflection', 'rejectionLesson', 'rejectedFromStatus', 'rejectedDate', 'offerDate', 'offerResponseDeadline', 'offerNotes', 'closingReason', 'closingNotes',
            // ⚠️ `packageId` TRAVELS WITH `materialsWanted` AND IS LISTED BESIDE IT ON PURPOSE.
            // `materialsLinkWrites` (packageMetrics.ts) enforces exactly one source of truth for a
            // query's materials — it writes the package link OR the free-text materials and always
            // clears the other — so every save that touches one touches both. `packageId` was
            // required by isValidQuery (a create-time shape check) but missing from THIS list, so
            // any update that CHANGED it failed hasOnly and the whole write was denied, silently,
            // taking the materials edit down with it. Live call site: EditQueryDrawer.tsx's
            // editMaterialsUpdate. Unchanged values were never affectedKeys, which is why attaching
            // a package failed while ordinary query edits did not — the narrow, quiet kind.
            'materialsWanted', 'packageId', 'ifNoResponse', 'agentId', 'rejectionType', 'agentComments',
            'fullVersionSent', 'revisionRound', 'hasAgentResponded', 'closureOfferDismissed', 'writerExpectedDate', 'writerExpectedSetAt'
          ])
        );

        match /activity/{activityId} {
          allow get, delete: if isOwner(userId) && isValidId(activityId);
          allow list: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(activityId) && isValidActivityNested(incoming());
        }
      }

      // ROUTE: Activities
      match /activities/{activityId} {
        allow get, delete: if isOwner(userId) && isValidId(activityId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(activityId) && isValidActivity(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(activityId) && isValidActivity(incoming(), userId) && (
          // ⚠️ `materials` MUST BE HERE OR EVERY MATERIALS WRITE IS SILENTLY DENIED. A field absent
          // from this allowlist fails with a permission error the UI shows as nothing happening —
          // the `affectedKeys` trap this repo has a note about. Added with the shape check above,
          // in the same deploy, because either alone is broken.
          // ⚠️ `queryId` AND `manuscriptId` ARE HERE BECAUSE AN EVENT CAN BE RE-FILED (correction
          // pack §B). Moving an entry to another query is a correction to WHERE a true event is
          // recorded, not a new event — so the document keeps its id and its contents, and exactly
          // these two fields change. Without them the authoritative log moved and the global-feed
          // twin stayed behind: the two-store divergence, one field deep, and the batch that
          // carries both was refused whole rather than half-applied.
          //
          // ⚠️ THEY MOVE TOGETHER OR NOT AT ALL. Allowing `queryId` alone would let an event be
          // filed under a query belonging to a different manuscript while the feed still counted
          // it against the old book — which is worse than the denial it replaces, because it looks
          // correct on the page the writer is standing on.
          incoming().diff(existing()).affectedKeys().hasOnly(['activityType', 'description', 'date', 'details', 'resultingStatus', 'materials', 'queryId', 'manuscriptId', 'bookVersionId'])
        );
      }

      // The top-level users/{uid}/activity store is RETIRED (Tier 3 · Phase 7): no match block
      // = default-deny, all ops. It had zero writers and one reader feeding unrendered state.
      // Legacy documents remain in Firestore, deliberately unreadable and unwritable — left in
      // place, not migrated (same treatment as the manuscripts-notes retirement). The nested
      // queries/{queryId}/activity subcollection above is the AUTHORITATIVE log and is unrelated.

      // ROUTE: JournalEntries
      match /journalEntries/{entryId} {
        allow get, delete: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidJournalEntry(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(entryId) && isValidJournalEntry(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['entryText', 'pinned'])
        );
      }

      // ROUTE: Notes (user-authored desk notes / dated tasks)
      match /notes/{noteId} {
        allow get, delete: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidUserNote(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(noteId) && isValidUserNote(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['text', 'colour', 'dueDate', 'done', 'doneAt', 'updatedAt'])
        );
      }

      // ROUTE: User tasks (users/{uid}/tasks) — the canonical stored to-do object. Owner-only;
      // optional record scope (queryId/agentId/manuscriptId) is user INPUT. EDITED, NOT DEPLOYED —
      // rides the parked deploy with personalGenres / genreSuggestions / note-scope.
      match /tasks/{taskId} {
        allow get, delete: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidUserTask(incoming(), userId);
        // ⚠️ committedDate IS IN THIS LIST BECAUSE IT IS CLIENT-UPDATED POST-CREATE (unblocked
        // 6 Aug 2026). Today's-list commit/uncommit (ToDoPage toggleToday → db.tsx
        // updateUserTask) and the Sunday review's Monday seeding (FocusFlow) both write it, and
        // while it was absent every one of those writes was denied SILENTLY — updateUserTask
        // swallowed the error and the optimistic patch rolled back on the next snapshot, so
        // committing a task to Today looked like it worked and then quietly undid itself.
        // The fix was known from the Tier 1 recon (4 Aug) and blocked only because two artefact
        // locks pinned the old string; all three halves land together. The VALUE shape needs no
        // guard here — isValidUserTask already enforces it on every update.
        allow update: if isOwner(userId) && isValidId(taskId) && isValidUserTask(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['text', 'detail', 'done', 'completedAt', 'updatedAt', 'dueDate', 'surfaceOffset', 'committedDate', 'tags', 'estimateMin', 'colour'])
        );
      }

      // ROUTE: DismissedTasks
      match /dismissedTasks/{dismissedId} {
        allow get, delete: if isOwner(userId) && isValidId(dismissedId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(dismissedId) && isValidDismissedTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(dismissedId) && isValidDismissedTask(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['snoozeDays', 'dismissType', 'resurfaceDate'])
        );
      }

      // ROUTE: taskFlags — the user's stance on derived tasks (owner-only). Deterministic-id docs.
      match /taskFlags/{flagId} {
        allow get, delete: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTaskFlag(incoming(), userId);
      }

      // ROUTE: tasks — the writer's own to-do items (owner-only). Read by the To-do "Your tasks"
      // column AND the per-record "View tasks" popover — one store, many views.
      // ROUTE: private — server-only entitlement state (Smart Import usage). The owner may READ it,
      // but NO client may write or delete it (write is admin-SDK only, which bypasses rules). Living
      // in a subcollection means it survives a delete-recreate of the user doc — Firestore never
      // cascade-deletes subcollections — so the free-once gate is genuinely tamper-proof.
      match /private/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ROUTE: communityAgents (shared across all users)
    // HARDENED (audit S1). Previously any signed-in user could update ANY community agent across
    // the whole allowlist (name/email/rating/counts/…), i.e. deface or poison the shared database.
    // The app's ONLY write to an existing community agent is a +1 bump of contributedByCount when a
    // user imports that agent (Discover.tsx / Dashboard.tsx, both best-effort/try-caught), so the
    // update surface is narrowed to exactly that. Editing the agents' own fields is an admin/seed
    // concern, never a client write.
    // LOCKED (FINDING-1): `create` and `delete` are now admin-only — closing the "any signed-in
    // user can inject agents into the shared pool" gap. Client seeding (seedCommunityAgentsIfEmpty)
    // runs only when the admin signs in. `update` deliberately stays open to any signed-in user but
    // is hard-narrowed to a single +1 bump of contributedByCount (no other field, no decrement),
    // which preserves the popularity counter without re-opening any injection/defacement surface.
    match /communityAgents/{agentId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(agentId) && isValidCommunityAgent(incoming());
      allow update: if isSignedIn() && isValidId(agentId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['contributedByCount'])
        && incoming().contributedByCount is int
        && incoming().contributedByCount == existing().contributedByCount + 1;
      allow delete: if isAdmin();
    }

    // ROUTE: Genre promotion queue (taxonomy Tier 3). One doc per (user, normalised label) — a
    // signal that several writers independently invented the same genre. A user may only create
    // their OWN suggestion (never read others' — privacy); only the admin reads the queue and
    // promotes/dismisses. Distinct-user count is derived admin-side by grouping on normalisedLabel.
    match /genreSuggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().keys().hasOnly(['id', 'normalisedLabel', 'label', 'userId', 'createdAt'])
        && incoming().normalisedLabel is string && incoming().normalisedLabel.size() <= 64
        && incoming().label is string && incoming().label.size() <= 64
        && incoming().createdAt is string && incoming().createdAt.size() <= 64;
      allow update, delete: if isAdmin();
    }

    // ROUTE: Founding-writer waitlist (holding page) — NO client access.
    // The holding-page form never touches Firestore directly; it posts to the `waitlist`
    // HTTP function, which writes via the Admin SDK and bypasses these rules. These explicit
    // denies are belt-and-braces over the default-deny catch-all, per the allowlist principle.
    match /waitlist/{id}  { allow read, write: if false; }
    match /counters/{id}  { allow read, write: if false; }

    // ROUTE: Waitlist rate-limit windows — NO client access.
    // One document per hashed IP per hour, written only by the `waitlist` function inside the
    // transaction that decides whether a submission is over the limit. A client READ would hand an
    // abuser the one thing the limit relies on staying opaque — how close they are to it — and a
    // client WRITE would be the limit itself, editable by the party it constrains.
    // ⚠️ THE ADDRESS IS HASHED WITH A SALT AND THE RAW IP IS NEVER STORED. It is personal data;
    // rate limiting and abuse review both work on a one-way hash, and the salt is what stops the
    // hash being reversed by enumerating IPv4 space.
    match /ratelimits/{window} { allow read, write: if false; }

    // ROUTE: Contact form (/contact) — NO client writes, admin-only reads.
    // The form posts to the `sendContactMessage` callable, which writes via the Admin SDK and
    // bypasses these rules. A client write path is deliberately absent: the form is PUBLIC, so an
    // open create rule would be an unauthenticated write endpoint with no honeypot and no rate
    // limit in front of it. `contactSenders` holds nothing but a hashed address and a timestamp —
    // it is the throttle's memory, and it is denied outright rather than made admin-readable,
    // because nobody needs to read it and a hashed mailing list is still a mailing list.
    match /contactMessages/{id} { allow read: if isAdmin(); allow write: if false; }
    match /contactSenders/{id}  { allow read, write: if false; }

    // ROUTE: Beta feedback dock — NO client writes, admin-only reads.
    // Same shape and same reasoning as contactMessages: the dock posts to the `sendBetaFeedback`
    // callable, which writes via the Admin SDK and bypasses these rules. A report names a fault in
    // the writer's own work in progress, so it is between them and the desk.
    match /betaFeedback/{id} { allow read: if isAdmin(); allow write: if false; }

    // ROUTE: Beta invite codes — NO client access whatsoever.
    // The signup gate posts to the `redeemInviteCode` callable, which validates and marks a code
    // used inside a transaction via the Admin SDK. A client READ would be the whole gate given
    // away: the collection IS the list of valid codes, so being able to read it is being able to
    // sign up. Not even the admin reads them here — seeding and auditing go through the console or
    // the Admin SDK, neither of which these rules govern.
    match /inviteCodes/{code} { allow read, write: if false; }
  }
}
