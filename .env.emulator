# Local emulator mode — `npm run dev:emu`, `npm run e2e:emu`. Nothing here is secret.
#
# ⚠️ THE `demo-` PREFIX IS THE SAFETY. The Firebase emulators refuse to reach any real project
# when the project id starts with `demo-`, and src/lib/firebaseTarget.ts refuses an emulator build
# that names anything else. Every read and write in this mode costs nothing.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-scriptally.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-scriptally
VITE_FIREBASE_STORAGE_BUCKET=demo-scriptally.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:demo
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_APP_CHECK_SITE_KEY=
